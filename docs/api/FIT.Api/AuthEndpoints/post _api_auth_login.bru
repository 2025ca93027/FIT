meta {
  name: post /api/auth/login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const json = res.body;
  
  if (!json?.accessToken) {
    throw new Error("No accessToken in response");
  }
  
  // Set runtime env var (NOT written to file)
  bru.setEnvVar("accessToken", json.accessToken);
}
